# Local authenticated development only. This mode is refused on Vercel.
APP_MODE=local
APP_ORIGIN=http://localhost:3000
LOCAL_DATA_DIR=.local-data
# Hosted workspace: set APP_MODE=supabase and configure these on the server.
# Use your project origin and PUBLIC/publishable API key, never a secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibility only when your project still uses a public legacy anon JWT:
# SUPABASE_ANON_KEY=
# APP_ORIGIN must be the exact deployed origin, without /gate or /records.
# Preview uses its own origin; do not pin it to the production hostname.
# SUPABASE_SERVICE_ROLE_KEY is for an isolated operator environment only.
# Do not add it to application runtime settings or commit it to any file.
