# Explicit mode; no implicit demo fallback. Local mode must never serve real data.
APP_MODE=local
APP_ORIGIN=http://localhost:3000
LOCAL_DATA_DIR=.local-data
# Production: set APP_MODE=supabase and configure these server-side values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used only by the operator-run provisioning script, never by the web app.
SUPABASE_SERVICE_ROLE_KEY=
